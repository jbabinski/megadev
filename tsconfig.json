{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"],
    "paths": {
      "#lib/*": ["./src/lib/*"]
    }
  },
  "include": ["src/lib/**/*.ts", "src/lib/**/*.svelte"]
}
